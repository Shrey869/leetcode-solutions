-->>>>88. Merge Sorted Array<<<<----
1.optimal
class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        // Step 1: nums2 ke saare elements ko nums1 ke end mein copy karo
        for (int i = 0; i < n; i++) {
            nums1[m + i] = nums2[i];
        }
        
        // Step 2: Poora nums1 sort karo
        Arrays.sort(nums1);
    }
}

